// 211 Categories Lookup Table (read-only, no primary key in DB)
model Tbl211Categories {
  ghId                 String   @map("gh_id") @db.Text
  generalHeading       String?  @map("general_heading") @db.Text
  groupId              String?  @map("group_id") @db.Text
  groupName            String?  @map("group_name") @db.Text
  iconNameFull         String?  @map("icon_name_full") @db.Text
  iconNameFullGroup    String?  @map("icon_name_full_group") @db.Text
  isFrench             Boolean  @default(false) @map("is_french")

  @@id([ghId, isFrench])
  @@map("tbl_211_categories")
}
