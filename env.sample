# Environment variables declared in this file are automatically made available to Prisma.
# See the documentation for more detail: https://pris.ly/d/prisma-schema#accessing-environment-variables-from-the-schema

# Prisma supports the native connection string format for PostgreSQL, MySQL, SQLite, SQL Server, MongoDB and CockroachDB.
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings
DATABASE_URL="postgresql://postgres:password@localhost:5432/mydb"
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=secret-key
AZURE_AD_CLIENT_ID=1111111-1111-1111-1111-1111111111
AZURE_AD_CLIENT_SECRET=secret-key
AZURE_AD_TENANT_ID=1111111-1111-1111-1111-1111111111
GEOSERVER_SCOPE=your-geoserver-app-id/client_access
NEXT_PUBLIC_ESRI_PORTAL_URL=https://arcgisportal/arcgis
NEXT_PUBLIC_ESRI_APP_ID=authorized-app-id
NEXT_PUBLIC_MAP_URL_SECURE=https://my.map/
NEXT_PUBLIC_MAP_URL_UNSECURE=https://my.map/
NEXT_PUBLIC_BASE_PATH=

# App Stats Collection - set to "true" to enable usage statistics collection
NEXT_PUBLIC_COLLECT_APP_STATS=false

# SQL Server Configuration for Property Reports
SQL_HOST=localhost
SQL_PORT=1433
SQL_TABULAR_DB=tabular
SQL_TABULAR_USER=user
SQL_TABULAR_PASS=your_password_here
SQL_WEBLIVE_DB=WEBLIVE
SQL_WEBLIVE_USER=user
SQL_WEBLIVE_PASS=your_password_here

# PostgreSQL Configuration for Property Reports
PG_HOST=localhost
PG_PORT=5432
PG_TABULAR_DB=tabular
PG_TABULAR_USER=user
PG_TABULAR_PASS=your_password_here
PG_WEBLIVE_DB=weblive
PG_WEBLIVE_USER=user
PG_WEBLIVE_PASS=your_password_here

# 511 Live Feeds - Waze API Configuration
WAZE_API_URL=https://www.waze.com/partnerhub-api/partners/your-partner-id/feed

# ArcGIS Token Generation (for secured MapServer services like AppTrack)
ARCGIS_OAUTH_TOKEN_URL=https://gisportal.simcoe.ca/arcgis/sharing/rest/oauth2/token
ARCGIS_READER_CLIENT_ID=your-client-id
ARCGIS_READER_CLIENT_SECRET=your-client-secret

# ArcGIS Editor Token Generation (for feature editing via /api/secure/arcgis/feature/*)
ARCGIS_TOKEN_URL=https://gisportal.simcoe.ca/arcgis/sharing/rest/generateToken
ARCGIS_EDITOR_USERNAME=opengis-editor
ARCGIS_EDITOR_PASSWORD=your-editor-password
ARCGIS_EDITOR_CLIENT=referer
ARCGIS_EDITOR_REFERER=https://opengis2.simcoe.ca/apiSecured
ARCGIS_EDITOR_EXPIRATION=10
# Optional JSON override of approved editing services (defaults to AppTrack + Road Closures)
# ARCGIS_EDITOR_ALLOWED_URLS=[{"name":"AppTrack","baseUrl":"...","operations":["addFeatures"],"roles":["planning"]}]

SALESFORCE_USERNAME=username
SALESFORCE_PASSWORD=password
SALESFORCE_CLIENT_ID=your-client-id
SALESFORCE_CLIENT_SECRET=your-client-secret
SALESFORCE_TOKEN_URL=https://your-instance.my.salesforce.com/services/oauth2/token
SALESFORCE_SERVICE_URL=https://your-instance.my.salesforce.com/services/data/v60.0
SALESFORCE_CLIENT_URL=https://your-instance.my.salesforce.com/lightning
