# Environment variables declared in this file are automatically made available to Prisma.
# See the documentation for more detail: https://pris.ly/d/prisma-schema#accessing-environment-variables-from-the-schema

# Prisma supports the native connection string format for PostgreSQL, MySQL, SQLite, SQL Server, MongoDB and CockroachDB.
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings
DATABASE_URL="postgresql://postgres:password@localhost:5432/mydb"
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=secret-key
AZURE_AD_CLIENT_ID=1111111-1111-1111-1111-1111111111
AZURE_AD_CLIENT_SECRET=secret-key
AZURE_AD_TENANT_ID=1111111-1111-1111-1111-1111111111
NEXT_PUBLIC_ESRI_PORTAL_URL=https://arcgisportal/arcgis
NEXT_PUBLIC_ESRI_APP_ID=authorized-app-id
NEXT_PUBLIC_MAP_URL_SECURE=https://my.map/
NEXT_PUBLIC_MAP_URL_UNSECURE=https://my.map/
NEXT_PUBLIC_BASE_PATH=

# SQL Server Configuration for Property Reports
SQL_HOST=localhost
SQL_PORT=1433
SQL_TABULAR_DB=tabular
SQL_TABULAR_USER=user
SQL_TABULAR_PASS=your_password_here
SQL_WEBLIVE_DB=WEBLIVE
SQL_WEBLIVE_USER=user
SQL_WEBLIVE_PASS=your_password_here

# PostgreSQL Configuration for Property Reports
PG_HOST=localhost
PG_PORT=5432
PG_TABULAR_DB=tabular
PG_TABULAR_USER=user
PG_TABULAR_PASS=your_password_here
PG_WEBLIVE_DB=weblive
PG_WEBLIVE_USER=user
PG_WEBLIVE_PASS=your_password_here
